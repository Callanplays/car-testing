if () {
    var crash_x = "%player.pos.x%D" false
    var crash_z = "%player.pos.z%D" false
    var crash_dx = "%var.player/crash_x%D" false
    var crash_dx -= "%var.player/car/last_x 0.0%D" false
    var crash_dz = "%var.player/crash_z%D" false
    var crash_dz -= "%var.player/car/last_z 0.0%D" false
}
if () {
    var crash_dx /= "%var.player/car/vel_scale%D" false
    var crash_dz /= "%var.player/car/vel_scale%D" false
    var car/obs_vx = "%var.player/crash_dx%D" false
    var car/obs_vx /= "%var.player/car/move_window%D" false
    var car/obs_vz = "%var.player/crash_dz%D" false
    var car/obs_vz /= "%var.player/car/move_window%D" false
}
if () {
    var crash_errx = "%var.player/crash_dx%D" false
    var crash_errx -= "%var.player/car/pred_x%D" false
    var crash_errz = "%var.player/crash_dz%D" false
    var crash_errz -= "%var.player/car/pred_z%D" false
    var car/impact = "%var.player/crash_errx%D" false
    var car/impact *= "%var.player/crash_errx%D" false
    var temp1 = "%var.player/crash_errz%D" false
    var temp1 *= "%var.player/crash_errz%D" false
    var car/impact += "%var.player/temp1%D" false
    var pred_move2 = "%var.player/car/pred_x%D" false
    var pred_move2 *= "%var.player/car/pred_x%D" false
    var temp1 = "%var.player/car/pred_z%D" false
    var temp1 *= "%var.player/car/pred_z%D" false
    var pred_move2 += "%var.player/temp1%D" false
    var crash_limit = "%var.player/pred_move2%D" false
    var crash_limit *= "%var.player/car/crash_ratio%D" false
    var temp1 unset
}
if (var car/crash_cd > 0.0 0.0) {
    var car/crash_cd -= 1.0 false
} else {
    var car/hud_crash = "" false
}
if (var car/crash_ready == 1.0 0.0, var pred_move2 > %var.player/car/crash_min2% 0.0, var car/impact > %var.player/crash_limit% 0.0, var car/crash_cd <= 0.0 0.0) {
    sound "random.anvil_land" 0.7 0.8 Invokers_Location
    var car/hud_crash = "&c&lCRASH" false
    var car/crash_cd = "%var.player/car/crash_cdmax%D" false
    var crash_rebound_x = "%var.player/car/obs_vx%D" false
    var crash_rebound_x -= "%var.player/car/vx%D" false
    var crash_rebound_x *= "%var.player/car/crash_bounce%D" false
    var car/vx = "%var.player/car/obs_vx%D" false
    var car/vx += "%var.player/crash_rebound_x%D" false
    var crash_rebound_z = "%var.player/car/obs_vz%D" false
    var crash_rebound_z -= "%var.player/car/vz%D" false
    var crash_rebound_z *= "%var.player/car/crash_bounce%D" false
    var car/vz = "%var.player/car/obs_vz%D" false
    var car/vz += "%var.player/crash_rebound_z%D" false
    var car/drifting = 0.0 false
    var car/drift_req = 0.0 false
}
if () {
    var car/crash_ready = 1.0 false
    var car/last_x = "%var.player/crash_x%D" false
    var car/last_z = "%var.player/crash_z%D" false
    var car/pred_x = 0.0 false
    var car/pred_z = 0.0 false
    var crash_x unset
