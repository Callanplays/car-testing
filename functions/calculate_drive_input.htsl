var accel_fwd = 0.0 false
var speed_ratio = "%var.player/speedsq%D" false
var speed_ratio /= "%var.player/car/maxspdsq%D" false
if (var speed_ratio > 1.0 0.0) {
    var speed_ratio = 1.0 false
}
var accel_drop = "%var.player/car/acc_drop%D" false
var accel_drop *= "%var.player/speed_ratio%D" false
var drive_acc = "%var.player/car/acc_launch%D" false
var drive_acc -= "%var.player/accel_drop%D" false
if (var car/state == 1 0.0) {
    var car/throttle += "%var.player/car/thr_rise%D" false
}
if (var car/state == 1 0.0, var car/throttle < %var.player/car/thr_start% 0.0) {
    var car/throttle = "%var.player/car/thr_start%D" false
}
if (var car/state == 1 0.0, var car/throttle > 1.0 0.0) {
    var car/throttle = 1.0 false
}
if (var car/state == 1 0.0) {
    var accel_fwd = "%var.player/drive_acc%D" false
    var accel_fwd *= "%var.player/car/throttle%D" false
}
if (!var car/state == 1 0.0) {
    var car/throttle -= "%var.player/car/thr_fall%D" false
}
if (var car/throttle < 0.0 0.0) {
    var car/throttle = 0.0 false
}
if (var car/state == 2 0.0, var fwd_chk > 0.12 0.0) {
    var accel_fwd = "%var.player/car/brake%D" false
}
if (var car/state == 2 0.0, var fwd_chk < -0.12 0.0) {
    var accel_fwd = "%var.player/car/brake%D" false
    var accel_fwd *= -1.0 false
}
if (var car/state == 0 0.0, var fwd_chk > 0.05 0.0) {
    var accel_fwd = "%var.player/car/eng_brk%D" false
}
if (var car/state == 0 0.0, var fwd_chk < -0.05 0.0) {
    var accel_fwd = "%var.player/car/eng_brk%D" false
    var accel_fwd *= -1.0 false
}
if (var car/state == 1 0.0, var speedsq > %var.player/car/maxspdsq% 0.0, var fwd_chk > 0.0 0.0) {
    var accel_fwd = 0.0 false
}
var speed_ratio unset
var accel_drop unset
var drive_acc unset
