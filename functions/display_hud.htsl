var speedsq = "%var.player/car/vx%D" false
var speedsq *= "%var.player/car/vx%D" false
var temp1 = "%var.player/car/vz%D" false
var temp1 *= "%var.player/car/vz%D" false
var speedsq += "%var.player/temp1%D" false
var temp1 unset
var hud_bar = "&8■■■■■■■■" false
if (var speedsq > 1.0 0.0) {
    var hud_bar = "&a■&8■■■■■■■" false
}
if (var speedsq > 5.0 0.0) {
    var hud_bar = "&a■■&8■■■■■■" false
}
if (var speedsq > 12.0 0.0) {
    var hud_bar = "&a■■■&8■■■■■" false
}
if (var speedsq > 21.0 0.0) {
    var hud_bar = "&a■■■&e■&8■■■■" false
}
if (var speedsq > 33.0 0.0) {
    var hud_bar = "&a■■■&e■■&8■■■" false
}
if (var speedsq > 48.0 0.0) {
    var hud_bar = "&a■■■&e■■■&8■■" false
}
if (var speedsq > 65.0 0.0) {
    var hud_bar = "&a■■■&e■■■&c■&8■" false
}
if (var speedsq > 85.0 0.0) {
    var hud_bar = "&a■■■&e■■■&c■■" false
}
var hud_mode = "&a&lGRIP" false
if (var car/drifting == 1.0 0.0) {
    var hud_mode = "&6&lDRIFTING" false
}
title "%var.player/hud_bar%" "%var.player/hud_mode%" 0 1 0
